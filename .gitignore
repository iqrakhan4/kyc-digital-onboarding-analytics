# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Private, raw and generated data.
# Only the .gitkeep placeholders are tracked.
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Local configuration (may reference private filenames / provider keywords).
# Committed templates use the *.example.json suffix instead.
config/*.local.*

# Generated databases
*.db
*.sqlite
*.sqlite3

# Generated files
*.log
*.tmp

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# Power BI: dashboards built from REAL data must never be committed.
# Name them *_real.pbix. A *_synthetic.pbix built from demo data may be committed.
*.pbix~
powerbi/*_real.pbix
powerbi/*.pbit
